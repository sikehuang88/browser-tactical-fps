# Godot 4 specific ignores
.godot/
/android/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Python asset-pipeline caches
__pycache__/
*.py[cod]

# Export output (binaries stay local; export_presets.cfg is versioned)
export/*.exe
export/*.pck
export/*.zip
export/*.tmp
export/*.console.exe

# OS junk
Thumbs.db
Desktop.ini

# Agent scratch (specs, reports, thumbnails — not shipped)
.frugal-fable/
